# Entity: bird

main: kit: entity: bird: {

  alias: field: {}

  fields: [
    {
      name: "commonNameDe"
      req: false
      short: "German common name"
      type: "`$STRING`"
    }
    {
      name: "commonNameEn"
      req: false
      short: "English common name"
      type: "`$STRING`"
    }
    {
      name: "commonNameFr"
      req: false
      short: "French common name"
      type: "`$STRING`"
    }
    {
      name: "commonNameIt"
      req: false
      short: "Italian common name"
      type: "`$STRING`"
    }
    {
      name: "conservationStatus"
      req: false
      short: "IUCN conservation status"
      type: "`$STRING`"
    }
    {
      name: "description"
      req: false
      short: "Detailed description of the bird"
      type: "`$STRING`"
    }
    {
      name: "family"
      req: false
      short: "Taxonomic family"
      type: "`$STRING`"
    }
    {
      name: "habitat"
      req: false
      short: "Preferred habitats"
      type: "`$ARRAY`"
    }
    {
      name: "id"
      req: false
      short: "Unique identifier for the bird"
      type: "`$STRING`"
    }
    {
      name: "imageUrl"
      req: false
      short: "URL to bird image"
      type: "`$STRING`"
    }
    {
      name: "length"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "order"
      req: false
      short: "Taxonomic order"
      type: "`$STRING`"
    }
    {
      name: "scientificName"
      req: false
      short: "Scientific name of the bird species"
      type: "`$STRING`"
    }
    {
      name: "weight"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "wingspan"
      req: false
      type: "`$OBJECT`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "bird"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                example: 100
                kind: "query"
                name: "limit"
                orig: "limit"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                example: 0
                kind: "query"
                name: "offset"
                orig: "offset"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "query"
                name: "search"
                orig: "search"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/api/birds"
          parts: [
            "api"
            "birds"
          ]
          select: {
            exist: [
              "limit"
              "offset"
              "search"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "bird_id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/api/birds/{birdId}"
          parts: [
            "api"
            "birds"
            "{id}"
          ]
          rename: {
            param: {
              birdId: "id"
            }
          }
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
